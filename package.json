{
  "name": "miniblog-m2",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de autores y publicaciones — Proyecto Integrador M2",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node --env-file-if-exists=.env scripts/run-sql.js setup",
    "db:seed": "node --env-file-if-exists=.env scripts/run-sql.js seed",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-db.js",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "supertest": "7.3.1",
    "vitest": "5.0.3"
  }
}
